{
	"name": "pi-extension-template",
	"version": "0.2.0",
	"description": "A Pi Coding Agent extension",
	"keywords": ["pi-package"],
	"type": "module",
	"main": "./dist/index.js",
	"exports": {
		".": {
			"import": "./dist/index.js",
			"require": "./dist/index.js",
			"types": "./dist/index.d.ts"
		}
	},
	"files": ["dist", "README.md"],
	"pi": {
		"extensions": ["./dist"]
	},
	"scripts": {
		"prepare": "husky",
		"check": "biome check --write . && tsc --noEmit",
		"build": "tsc",
		"dev": "tsc --watch"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.0",
		"@earendil-works/pi-coding-agent": "^0.75.0",
		"typebox": "^1.1.0",
		"@types/node": "^22.0.0",
		"husky": "^9.0.0",
		"typescript": "^5.7.0"
	}
}
